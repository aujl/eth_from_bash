#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
export REPO_ROOT

# shellcheck source=scripts/lib/common/bootstrap.sh
source "${REPO_ROOT}/scripts/lib/common/bootstrap.sh"
# shellcheck source=scripts/cli/ethereum.sh
source "${REPO_ROOT}/scripts/cli/ethereum.sh"
# shellcheck source=scripts/lib/flows/ethereum.sh
source "${REPO_ROOT}/scripts/lib/flows/ethereum.sh"

ethereum_cli_main "${REPO_ROOT}" "$@"
