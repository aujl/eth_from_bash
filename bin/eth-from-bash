#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
export REPO_ROOT

for lib in "${REPO_ROOT}/scripts/lib/bootstrap.sh" "${REPO_ROOT}/scripts/lib/common.sh"; do
  [[ -r "${lib}" ]] || continue
  # shellcheck source=/dev/null
  source "${lib}"
done

cli_entrypoint="${REPO_ROOT}/eth-from-bash.sh"
if [[ ! -x "${cli_entrypoint}" ]]; then
  echo "CLI entrypoint '${cli_entrypoint}' not executable" >&2
  exit 1
fi

exec "${cli_entrypoint}" "$@"
