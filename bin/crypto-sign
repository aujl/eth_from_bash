#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
export REPO_ROOT

ENTRYPOINT="${REPO_ROOT}/scripts/crypto_sign.sh"

if [[ ! -x "${ENTRYPOINT}" ]]; then
  echo "crypto-sign backend '${ENTRYPOINT}' not executable" >&2
  exit 1
fi

exec "${ENTRYPOINT}" "$@"
