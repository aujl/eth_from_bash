#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
export REPO_ROOT

# shellcheck source=scripts/lib/common/bootstrap.sh
source "${REPO_ROOT}/scripts/lib/common/bootstrap.sh"
# Intentionally avoid bootstrap_cli_environment here because it force-sources
# the canonical SHA-2 library, which would mask tamper-injection tests that use
# BASH_ENV overrides. We only need helper path defaults + executable checks.
eth_from_bash::set_helper_defaults "${REPO_ROOT}"
eth_from_bash::ensure_helper_executables
eth_from_bash::require_commands jq bc xxd awk

check_deps_script="${REPO_ROOT}/scripts/check_deps.sh"
if [[ ! -r "${check_deps_script}" ]]; then
  echo "Dependency checker script '${check_deps_script}' not found" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "${check_deps_script}"

if ! declare -F eth_from_bash::check_deps >/dev/null 2>&1; then
  echo "Dependency checker function not available" >&2
  exit 1
fi

eth_from_bash::check_deps "$@"
