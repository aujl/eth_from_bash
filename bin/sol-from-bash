#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
export REPO_ROOT

# shellcheck source=scripts/lib/common/bootstrap.sh
source "${REPO_ROOT}/scripts/lib/common/bootstrap.sh"
eth_from_bash::bootstrap_cli_environment "${REPO_ROOT}"
eth_from_bash::source_relative "${REPO_ROOT}" \
  "scripts/lib/chains/solana.sh" \
  "scripts/lib/crypto/ed25519.sh" \
  "scripts/lib/encoding/base58.sh"

if ! eth_from_bash::require_commands xxd bc; then
  exit 1
fi

BIP39_HELPER="${BIP39_HELPER}"  # shellcheck disable=SC2034 keep exported defaults
CRYPTO_KDF_HELPER="${CRYPTO_KDF_HELPER}"  # shellcheck disable=SC2034 keep exported defaults

ENT_HEX_ENV="${ENT_HEX-}"
MNEMONIC_ENV="${MNEMONIC-}"

QUIET=0
INCLUDE_SEED=0
USER_MNEMONIC=""
DERIVATION_PATH="m/44'/501'/0'/0'"
USE_ENV_MNEMONIC=0

usage() {
  cat <<'USAGE'
Usage: sol-from-bash [options] <wordlist> [passphrase]

Options:
  -q, --quiet          Only emit JSON result
  --include-seed       Include BIP39 seed in JSON output
  --mnemonic PHRASE    Use the provided mnemonic phrase
  --path PATH          Override derivation path (default m/44'/501'/0'/0')
USAGE
}

if [[ -n "${MNEMONIC_ENV}" ]]; then
  USER_MNEMONIC="${MNEMONIC_ENV}"
  USE_ENV_MNEMONIC=1
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -q|--quiet)
      QUIET=1
      shift
      ;;
    --include-seed)
      INCLUDE_SEED=1
      shift
      ;;
    --mnemonic)
      if (( USE_ENV_MNEMONIC == 1 )); then
        echo "MNEMONIC environment variable is set; remove --mnemonic" >&2
        exit 2
      fi
      shift
      USER_MNEMONIC="${1-}"
      if [[ -z "${USER_MNEMONIC}" ]]; then
        echo "--mnemonic requires a value" >&2
        exit 2
      fi
      shift
      ;;
    --path)
      shift
      DERIVATION_PATH="${1-}"
      if [[ -z "${DERIVATION_PATH}" ]]; then
        echo "--path requires a value" >&2
        exit 2
      fi
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

WLIST="$1"
shift || true
PASSPHRASE="${*:-}"

if [[ ! -r "${WLIST}" ]]; then
  echo "Wordlist '${WLIST}' not readable" >&2
  exit 1
fi

bip39_load_wordlist "${WLIST}"

sdebug() {
  if (( QUIET == 0 )); then
    echo "$@" >&2
  fi
}

ENT_HEX_VALUE=""
if [[ -n "${ENT_HEX_ENV}" ]]; then
  if ! ENT_HEX_VALUE="$(bip39_validate_entropy_hex "${ENT_HEX_ENV}")"; then
    exit 2
  fi
fi

if [[ -z "${USER_MNEMONIC}" ]]; then
  if [[ -z "${ENT_HEX_VALUE}" ]]; then
    if ! ENT_HEX_VALUE="$(bip39_generate_entropy_hex)"; then
      exit 1
    fi
  fi
else
  ENT_HEX_VALUE=""
fi

if [[ -z "${USER_MNEMONIC}" ]]; then
  MNEMONIC="$(bip39_build_mnemonic_from_entropy "${ENT_HEX_VALUE}")"
else
  if ! MNEMONIC="$(bip39_validate_mnemonic "${USER_MNEMONIC}")"; then
    exit 2
  fi
fi

SEED_HEX="$(${BIP39_HELPER} --mnemonic "${MNEMONIC}" --passphrase "${PASSPHRASE}")"

sdebug "Hex Seed: ${SEED_HEX}"

read -r master_key master_chain < <(solana_slip10_master_from_seed "${SEED_HEX}")
mapfile -t path_segments < <(solana_slip10_parse_path "${DERIVATION_PATH}")
if (( ${#path_segments[@]} > 0 )); then
  read -r master_key master_chain < <(solana_slip10_derive_path_segments "${master_key}" "${master_chain}" "${path_segments[@]}")
fi

read -r priv_key_hex pub_key_hex < <(ed25519_derive_keypair_hex "${master_key}")
address_base58="$(base58_encode_hex "${pub_key_hex}" 1)"

if (( QUIET == 0 )); then
  sdebug "Private: ${priv_key_hex}"
  sdebug "Public:  ${pub_key_hex}"
  sdebug "Address: ${address_base58}"
fi

if (( INCLUDE_SEED == 1 )); then
  printf '{"mnemonic":"%s","path":"%s","privateKey":"%s","publicKey":"%s","address":"%s","seed":"%s"}\n' \
    "${MNEMONIC}" "${DERIVATION_PATH}" "${priv_key_hex}" "${pub_key_hex}" "${address_base58}" "${SEED_HEX}"
else
  printf '{"mnemonic":"%s","path":"%s","privateKey":"%s","publicKey":"%s","address":"%s"}\n' \
    "${MNEMONIC}" "${DERIVATION_PATH}" "${priv_key_hex}" "${pub_key_hex}" "${address_base58}"
fi
